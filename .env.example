# ================== CẤU HÌNH CHUNG ==================
# mysql (XAMPP) hoặc sqlite (không cần cài MySQL, file lưu trong thư mục data/)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
SQLITE_DIR=./data

# ================== TH2 - AUTH SERVICE ==================
AUTH_PORT=5000
AUTH_DB_NAME=auth_service_db
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=1d

# ================== TH3 - PRODUCT SERVICE ==================
PRODUCT_PORT=5001
PRODUCT_DB_NAME=product_service_db

# ================== TH4 - ORDER SERVICE ==================
ORDER_PORT=5002
ORDER_DB_NAME=order_service_db
# true => trừ kho khi đặt hàng, hoàn kho khi hủy/xóa
UPDATE_PRODUCT_STOCK=true

# ================== GIAO DIỆN WEB ==================
WEB_PORT=3000

# ================== LIÊN KẾT GIỮA CÁC SERVICE ==================
# Để trống => tự dùng localhost + cổng ở trên
AUTH_VERIFY_URL=
PRODUCT_SERVICE_URL=
# false => tắt xác thực (chỉ dùng khi debug)
AUTH_ENABLED=true
