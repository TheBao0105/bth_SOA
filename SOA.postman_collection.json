{
  "info": {
    "name": "SOA - TH2 Auth / TH3 Product / TH4 Order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:5000" },
    { "key": "productUrl", "value": "http://localhost:5001" },
    { "key": "orderUrl", "value": "http://localhost:5002" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "itemId", "value": "1" }
  ],
  "item": [
    {
      "name": "TH2 - Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{authUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"sv01\",\n  \"email\": \"sv01@example.com\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{authUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"sv01\",\n  \"password\": \"123456\"\n}" }
          }
        },
        { "name": "Verify token", "request": { "method": "GET", "url": "{{authUrl}}/auth/verify" } },
        { "name": "Me", "request": { "method": "GET", "url": "{{authUrl}}/auth/me" } }
      ]
    },
    {
      "name": "TH3 - Product",
      "item": [
        { "name": "GET all products", "request": { "method": "GET", "url": "{{productUrl}}/products" } },
        { "name": "GET product by id", "request": { "method": "GET", "url": "{{productUrl}}/products/{{productId}}" } },
        {
          "name": "POST create product",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "url": "{{productUrl}}/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tai nghe Sony WH-1000XM5\",\n  \"description\": \"Tai nghe chống ồn\",\n  \"price\": 7500000,\n  \"quantity\": 15\n}" }
          }
        },
        {
          "name": "PUT update product",
          "request": {
            "method": "PUT",
            "url": "{{productUrl}}/products/{{productId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 7000000,\n  \"quantity\": 20\n}" }
          }
        },
        { "name": "DELETE product", "request": { "method": "DELETE", "url": "{{productUrl}}/products/{{productId}}" } }
      ]
    },
    {
      "name": "TH4 - Orders",
      "item": [
        { "name": "GET all orders", "request": { "method": "GET", "url": "{{orderUrl}}/orders" } },
        { "name": "GET order by id", "request": { "method": "GET", "url": "{{orderUrl}}/orders/{{orderId}}" } },
        {
          "name": "POST create order",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().data.id);"] } }],
          "request": {
            "method": "POST",
            "url": "{{orderUrl}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Nguyễn Văn A\",\n  \"customer_email\": \"a@example.com\",\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2 },\n    { \"product_id\": 2, \"quantity\": 1 }\n  ]\n}" }
          }
        },
        {
          "name": "PUT update order status",
          "request": {
            "method": "PUT",
            "url": "{{orderUrl}}/orders/{{orderId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }
          }
        },
        { "name": "DELETE order", "request": { "method": "DELETE", "url": "{{orderUrl}}/orders/{{orderId}}" } }
      ]
    },
    {
      "name": "TH4 - Order items",
      "item": [
        { "name": "GET all order items", "request": { "method": "GET", "url": "{{orderUrl}}/order_items" } },
        { "name": "GET order item by id", "request": { "method": "GET", "url": "{{orderUrl}}/order_items/{{itemId}}" } },
        {
          "name": "POST create order item",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('itemId', pm.response.json().data.id);"] } }],
          "request": {
            "method": "POST",
            "url": "{{orderUrl}}/order_items",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": {{orderId}},\n  \"product_id\": 3,\n  \"quantity\": 1\n}" }
          }
        },
        {
          "name": "PUT update order item",
          "request": {
            "method": "PUT",
            "url": "{{orderUrl}}/order_items/{{itemId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" }
          }
        },
        { "name": "DELETE order item", "request": { "method": "DELETE", "url": "{{orderUrl}}/order_items/{{itemId}}" } }
      ]
    }
  ]
}
